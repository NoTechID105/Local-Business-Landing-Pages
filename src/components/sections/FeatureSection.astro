---
import Container from '../common/Container.astro';
import type { SimpleItem } from '../../data/businesses/types';

interface Props {
  features: SimpleItem[];
}

const { features } = Astro.props;
const [mainFeature, ...otherFeatures] = features.slice(0, 5);
---

{
  mainFeature && (
    <section id="keunggulan" class="bg-gray-950 py-16 text-white sm:py-20 lg:py-24">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <div>
            <p class="text-[0.95rem] font-bold uppercase tracking-wide text-[var(--theme-accent,#f59e0b)]">Keunggulan</p>
            <h2 class="mt-3 max-w-2xl text-3xl font-black leading-tight text-white sm:text-4xl">
              Kenapa Memilih Kami?
            </h2>
            <p class="mt-4 max-w-xl text-base leading-8 text-gray-300 sm:text-lg">
              Layanan dirancang untuk kebutuhan pelanggan lokal dengan proses yang jelas, rapi, dan mudah dihubungi.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <article class="rounded-3xl border border-white/10 bg-white p-7 text-gray-950 shadow-lg shadow-gray-950/20 sm:col-span-2">
              <p class="text-[0.95rem] font-bold uppercase tracking-wide text-[var(--theme-primary,#ea580c)]">Keunggulan utama</p>
              <h3 class="mt-4 text-2xl font-black">{mainFeature.title}</h3>
              <p class="mt-3 max-w-2xl text-base leading-8 text-gray-600">{mainFeature.description}</p>
            </article>

            {otherFeatures.map((feature, index) => (
              <article class="rounded-2xl border border-white/10 bg-white/5 p-6">
                <p class="text-[0.95rem] font-bold text-[var(--theme-accent,#f59e0b)]">
                  {feature.icon ?? String(index + 2).padStart(2, '0')}
                </p>
                <h3 class="mt-4 text-lg font-bold text-white">{feature.title}</h3>
                <p class="mt-2 text-base leading-8 text-gray-300">{feature.description}</p>
              </article>
            ))}
          </div>
        </div>
      </Container>
    </section>
  )
}
