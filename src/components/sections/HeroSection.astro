---
import Button from '../common/Button.astro';
import Container from '../common/Container.astro';
import type { BusinessTheme, HeroData } from '../../data/businesses/types';

interface Props {
  hero: HeroData;
  theme: BusinessTheme;
  whatsappUrl: string;
}

const { hero, theme, whatsappUrl } = Astro.props;

const secondaryHref =
  hero.secondaryCta.href ?? (hero.secondaryCta.targetId ? `#${hero.secondaryCta.targetId}` : undefined);

const themeStyle = [
  `--theme-primary: ${theme.colors.primary}`,
  `--theme-secondary: ${theme.colors.secondary}`,
  `--theme-accent: ${theme.colors.accent}`,
  `--theme-background: ${theme.colors.background}`,
  `--theme-surface: ${theme.colors.surface}`,
  `--theme-text: ${theme.colors.text}`,
  `--theme-muted: ${theme.colors.muted}`,
  `--theme-soft: ${theme.colors.primary}12`,
  `--theme-accent-soft: ${theme.colors.accent}18`,
].join('; ');

const heroStats = hero.highlights.slice(0, 3);
---

<section
  class="relative overflow-hidden bg-[var(--theme-background)] py-16 sm:py-20 lg:py-24"
  style={themeStyle}
>
  <div
    aria-hidden="true"
    class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-white/70 to-transparent"
  >
  </div>
  <div
    aria-hidden="true"
    class="absolute right-0 top-16 h-56 w-1/2 -skew-y-6 bg-[var(--theme-accent-soft)]"
  >
  </div>

  <Container class="relative">
    <div class="grid items-center gap-10 lg:grid-cols-[0.95fr_1.05fr]">
      <div>
        <div class="inline-flex items-center gap-2 rounded-2xl border border-white/70 bg-white/75 px-3 py-2 text-base font-semibold text-[var(--theme-primary)] shadow-sm backdrop-blur">
          <span class="h-2 w-2 rounded-full bg-[var(--theme-accent)]"></span>
          {hero.eyebrow}
        </div>

        <h1 class="mt-5 max-w-3xl text-[2.35rem] font-black leading-[1.08] text-[var(--theme-text)] sm:text-5xl sm:leading-tight lg:text-6xl">
          {hero.title}
        </h1>

        <p class="mt-5 max-w-2xl text-base leading-8 text-[var(--theme-muted)] sm:text-lg">
          {hero.subtitle}
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href={whatsappUrl} size="lg" class="w-full sm:w-auto" ariaLabel={hero.primaryCta.label}>
            {hero.primaryCta.label}
          </Button>

          {
            secondaryHref && (
              <Button href={secondaryHref} variant="outline" size="lg" class="w-full bg-white/80 sm:w-auto" ariaLabel={hero.secondaryCta.label}>
                {hero.secondaryCta.label}
              </Button>
            )
          }
        </div>

        {
          heroStats.length > 0 && (
            <div class="mt-8 grid gap-3 sm:grid-cols-3">
              {heroStats.map((highlight) => (
                <div class="rounded-2xl border border-white/70 bg-white/75 p-4 shadow-sm backdrop-blur">
                  <p class="text-base font-bold text-[var(--theme-text)]">{highlight}</p>
                  <p class="mt-1 text-[0.95rem] font-medium text-[var(--theme-muted)]">Info cepat</p>
                </div>
              ))}
            </div>
          )
        }
      </div>

      <div class="relative">
        <div class="absolute -left-4 top-8 hidden h-24 w-24 rounded-lg bg-white/65 shadow-sm lg:block"></div>
        <div class="absolute -right-3 bottom-10 hidden h-32 w-24 rounded-[1.35rem] bg-[var(--theme-soft)] shadow-sm lg:block"></div>

        <div class="relative overflow-hidden rounded-[1.75rem] border border-white/80 bg-white p-3 shadow-2xl shadow-gray-950/10">
          <div class="relative aspect-[4/3] overflow-hidden rounded-[1.35rem] bg-[var(--theme-soft)]">
            <div
              aria-hidden="true"
              class="absolute inset-0"
              style={`background: linear-gradient(135deg, ${theme.colors.primary}1f, ${theme.colors.accent}30);`}
            >
            </div>

            <div class="absolute inset-0 flex items-center justify-center p-8 text-center">
              <div>
                <p class="text-base font-semibold uppercase text-[var(--theme-primary)]">{theme.mood[0]}</p>
                <p class="mt-2 text-2xl font-bold text-[var(--theme-text)]">{theme.name}</p>
              </div>
            </div>

            {
              hero.image && (
                <img
                  src={hero.image}
                  alt={hero.imageAlt}
                  class="absolute inset-0 h-full w-full object-cover"
                  loading="eager"
                  onerror="this.style.display='none'"
                />
              )
            }
          </div>

          <div class="grid gap-3 p-3 sm:grid-cols-2">
            <div class="rounded-2xl bg-gray-950 p-5 text-white">
              <p class="text-[0.82rem] font-semibold uppercase text-white/60">Karakter</p>
              <p class="mt-2 text-base font-semibold">{theme.mood.slice(0, 3).join(' / ')}</p>
            </div>
            <div class="rounded-2xl border border-gray-200 bg-white p-5">
              <p class="text-[0.82rem] font-semibold uppercase text-gray-500">Kepercayaan</p>
              <p class="mt-2 text-base font-semibold text-gray-950">Dipercaya pelanggan lokal</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
