---
import Container from '../common/Container.astro';
import SectionHeader from '../common/SectionHeader.astro';
import type { TestimonialItem } from '../../data/businesses/types';

interface Props {
  testimonials: TestimonialItem[];
}

const { testimonials } = Astro.props;
---

{
  testimonials.length > 0 && (
    <section id="testimoni" class="bg-[var(--theme-background,#fff7ed)] py-16 sm:py-20 lg:py-24">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
          <div class="lg:sticky lg:top-24">
            <SectionHeader
              eyebrow="Testimoni"
              title="Apa Kata Pelanggan?"
              description="Cerita pelanggan yang sudah menggunakan layanan dan merasa terbantu."
            />
          </div>

          <div class="grid gap-4 md:grid-cols-3">
            {testimonials.map((testimonial, index) => {
              const rating = Math.min(testimonial.rating ?? 5, 5);
              const initials = testimonial.name
                .split(' ')
                .filter(Boolean)
                .map((word) => word[0])
                .join('')
                .slice(0, 2)
                .toUpperCase();

              return (
                <article
                  class:list={[
                    'rounded-3xl border border-white/80 bg-white p-7 shadow-sm',
                    index === 1 ? 'md:translate-y-8' : '',
                  ]}
                >
                  <div class="flex items-center gap-3">
                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-[var(--theme-secondary,#111827)] text-[0.95rem] font-bold text-white">
                      {initials}
                    </div>
                    <div>
                      <p class="text-lg font-bold text-gray-950">{testimonial.name}</p>
                      {testimonial.role && <p class="text-base text-gray-500">{testimonial.role}</p>}
                    </div>
                  </div>

                  <p class="mt-5 text-base font-medium leading-8 text-gray-800">"{testimonial.quote}"</p>

                  <div class="mt-5 flex items-center justify-between border-t border-gray-100 pt-4">
                    <div class="text-[0.95rem] font-bold text-[var(--theme-primary,#ea580c)]" aria-label={`${rating} dari 5 bintang`}>
                      <span aria-hidden="true">
                        {Array.from({ length: rating }).map(() => (
                          <span>&#9733;</span>
                        ))}
                      </span>
                    </div>
                    <span class="text-[0.95rem] font-semibold uppercase text-gray-400">Review</span>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </Container>
    </section>
  )
}
