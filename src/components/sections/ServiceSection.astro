---
import Container from '../common/Container.astro';
import SectionHeader from '../common/SectionHeader.astro';
import type { ServiceItem } from '../../data/businesses/types';

interface Props {
  services: ServiceItem[];
}

const { services } = Astro.props;
const [featuredService, ...otherServices] = services;
---

{
  services.length > 0 && (
    <section id="layanan" class="bg-gray-50/70 py-16 sm:py-20 lg:py-24">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
          <div class="lg:sticky lg:top-24">
            <SectionHeader
              eyebrow="Layanan"
              title="Layanan yang Tersedia"
              description="Pilih layanan sesuai kebutuhan, mulai dari paket utama sampai kebutuhan custom."
            />

            {featuredService && (
              <article class="mt-8 overflow-hidden rounded-3xl border border-gray-200 bg-[var(--theme-background,#fff7ed)] shadow-lg shadow-gray-950/5">
                <div class="p-6">
                  <div class="flex items-start justify-between gap-4">
                    <span class="rounded-xl bg-white px-3 py-2 text-[0.95rem] font-bold uppercase text-[var(--theme-primary,#ea580c)] shadow-sm">
                      Layanan utama
                    </span>
                    {featuredService.badge && (
                      <span class="rounded-xl bg-[var(--theme-primary,#ea580c)] px-3 py-2 text-[0.95rem] font-bold text-white">
                        {featuredService.badge}
                      </span>
                    )}
                  </div>

                  <h3 class="mt-5 text-2xl font-black text-gray-950">{featuredService.title}</h3>
                  <p class="mt-3 text-base leading-8 text-gray-700">{featuredService.description}</p>
                  {featuredService.price && (
                    <p class="mt-5 text-lg font-bold text-[var(--theme-primary,#ea580c)]">
                      {featuredService.price}
                    </p>
                  )}
                </div>

                {featuredService.includes && featuredService.includes.length > 0 && (
                  <div class="grid gap-px bg-black/5 sm:grid-cols-3">
                    {featuredService.includes.slice(0, 3).map((item) => (
                      <div class="bg-white/80 p-5 text-base font-medium text-gray-700">
                        {item}
                      </div>
                    ))}
                  </div>
                )}
              </article>
            )}
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            {otherServices.map((service, index) => (
              <article
                class:list={[
                  'group rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-[var(--theme-primary,#ea580c)] hover:shadow-md',
                  index % 3 === 1 ? 'sm:translate-y-6' : '',
                ]}
              >
                <div class="flex items-start justify-between gap-4">
                  <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[var(--theme-soft,#fff7ed)] text-base font-bold text-[var(--theme-primary,#ea580c)]">
                    {service.icon ?? String(index + 2).padStart(2, '0')}
                  </div>
                  {service.badge && (
                    <span class="rounded-lg bg-gray-100 px-3 py-1 text-[0.82rem] font-semibold text-gray-600">
                      {service.badge}
                    </span>
                  )}
                </div>

                <h3 class="mt-5 text-xl font-bold text-gray-950">{service.title}</h3>
                <p class="mt-3 text-base leading-8 text-gray-600">{service.description}</p>

                <div class="mt-5 flex items-center justify-between gap-3 border-t border-gray-100 pt-4">
                  {service.price && <p class="text-base font-bold text-[var(--theme-primary,#ea580c)]">{service.price}</p>}
                  <p class="text-[0.95rem] font-semibold uppercase text-gray-400">Detail layanan</p>
                </div>

                {service.includes && service.includes.length > 0 && (
                  <ul class="mt-4 space-y-2 text-base leading-7 text-gray-600">
                    {service.includes.slice(0, 2).map((item) => (
                      <li class="flex gap-2">
                        <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--theme-accent,#f59e0b)]"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </div>
        </div>
      </Container>
    </section>
  )
}
