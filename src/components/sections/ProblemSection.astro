---
import Container from '../common/Container.astro';
import SectionHeader from '../common/SectionHeader.astro';
import type { SimpleItem } from '../../data/businesses/types';

interface Props {
  items: SimpleItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section id="problem" class="bg-white py-16 sm:py-20 lg:py-24">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[1fr_1.15fr] lg:items-center">
          <div>
            <SectionHeader
              eyebrow="Problem"
              title="Masalah yang Sering Dialami Pelanggan"
              description="Bagian ini dibuat seperti percakapan awal dengan pelanggan: apa yang mengganggu mereka, lalu layanan hadir sebagai solusi."
            />
          </div>

          <div class="rounded-3xl border border-gray-200 bg-[var(--theme-background,#fff7ed)] p-5 shadow-sm">
            <div class="grid gap-3">
              {items.map((item, index) => (
                <article class="rounded-2xl bg-white p-6 shadow-sm">
                  <div class="flex gap-4">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-[var(--theme-primary,#ea580c)] text-[0.95rem] font-bold text-white">
                      {item.icon ?? String(index + 1).padStart(2, '0')}
                    </div>
                    <div>
                      <h3 class="text-lg font-bold text-gray-950">{item.title}</h3>
                      <p class="mt-2 text-base leading-8 text-gray-600">{item.description}</p>
                      {item.note && <p class="mt-3 text-base font-medium text-gray-800">{item.note}</p>}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </Container>
    </section>
  )
}
