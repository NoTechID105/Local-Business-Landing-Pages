---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'inverted';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  target?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  target,
  ariaLabel,
} = Astro.props;

const baseClasses =
  'inline-flex items-center justify-center rounded-xl font-semibold transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--theme-primary,#ea580c)] focus-visible:ring-offset-2';

const variantClasses = {
  primary: 'bg-[var(--theme-primary,#ea580c)] text-white shadow-sm hover:opacity-90',
  secondary: 'bg-[var(--theme-soft,#fff7ed)] text-[var(--theme-primary,#ea580c)] hover:opacity-90',
  outline: 'border border-gray-300 bg-white text-gray-900 hover:border-[var(--theme-primary,#ea580c)] hover:text-[var(--theme-primary,#ea580c)]',
  ghost: 'text-gray-700 hover:bg-gray-100 hover:text-gray-950',
  inverted: 'border border-white/30 bg-transparent text-white hover:bg-white hover:text-gray-950',
};

const sizeClasses = {
  sm: 'min-h-10 px-4 py-2.5 text-[0.95rem]',
  md: 'min-h-11 px-5 py-3 text-base',
  lg: 'min-h-12 px-6 py-3 text-base',
};

const classes = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
const rel = target === '_blank' ? 'noopener noreferrer' : undefined;
---

{
  href ? (
    <a href={href} target={target} rel={rel} aria-label={ariaLabel} class={classes}>
      <slot />
    </a>
  ) : (
    <button type="button" aria-label={ariaLabel} class={classes}>
      <slot />
    </button>
  )
}
