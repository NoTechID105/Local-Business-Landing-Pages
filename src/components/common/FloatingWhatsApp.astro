---
interface Props {
  whatsappUrl: string;
  label?: string;
}

const { whatsappUrl, label = 'Chat WhatsApp' } = Astro.props;
---

<a
  href={whatsappUrl}
  aria-label={label}
  title={label}
  class="fixed bottom-5 right-5 z-50 inline-flex h-12 w-12 items-center justify-center rounded-full bg-green-500 text-white shadow-lg shadow-green-900/20 transition hover:-translate-y-0.5 hover:bg-green-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600 sm:h-14 sm:w-14"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 32 32"
    class="h-6 w-6"
    fill="currentColor"
  >
    <path d="M16.02 3.2A12.72 12.72 0 0 0 5.08 22.4L3.6 28.8l6.56-1.45A12.7 12.7 0 1 0 16.02 3.2Zm0 23.16c-1.9 0-3.75-.52-5.36-1.5l-.38-.23-3.88.86.87-3.78-.25-.39a10.32 10.32 0 1 1 9 5.04Zm5.67-7.74c-.31-.16-1.84-.91-2.12-1.01-.28-.1-.49-.16-.7.16-.2.31-.8 1.01-.98 1.22-.18.2-.36.23-.67.08-.31-.16-1.31-.48-2.5-1.54-.92-.82-1.55-1.84-1.73-2.15-.18-.31-.02-.48.14-.63.14-.14.31-.36.47-.54.16-.18.2-.31.31-.52.1-.2.05-.39-.03-.54-.08-.16-.7-1.68-.95-2.3-.25-.6-.5-.52-.7-.53h-.6c-.2 0-.54.08-.82.39-.28.31-1.08 1.05-1.08 2.56 0 1.5 1.1 2.96 1.25 3.16.16.2 2.17 3.31 5.25 4.64.73.32 1.31.51 1.76.65.74.23 1.41.2 1.94.12.59-.09 1.84-.75 2.1-1.48.26-.73.26-1.35.18-1.48-.08-.13-.28-.2-.6-.36Z" />
  </svg>
  <span class="sr-only">{label}</span>
</a>
