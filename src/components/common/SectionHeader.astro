---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props;

const alignmentClasses = {
  left: 'items-start text-left',
  center: 'items-center text-center',
};
---

<div class={`flex max-w-3xl flex-col gap-3 ${alignmentClasses[align]}`}>
  {
    eyebrow && (
      <p class="text-[0.95rem] font-bold uppercase tracking-wide text-[var(--theme-primary,#c2410c)]">
        {eyebrow}
      </p>
    )
  }

  <h2 class="text-3xl font-black leading-tight text-gray-950 sm:text-4xl">
    {title}
  </h2>

  {
    description && (
      <p class="text-base leading-8 text-gray-600 sm:text-lg">
        {description}
      </p>
    )
  }
</div>
