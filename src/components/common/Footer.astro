---
import Container from './Container.astro';
import type { BusinessLogo } from '../../data/businesses/types';

interface Props {
  businessName: string;
  tagline: string;
  address: string;
  openingHours: string;
  whatsappUrl: string;
  logoText?: string;
  logo?: BusinessLogo;
  navItems?: {
    label: string;
    href: string;
  }[];
}

const {
  businessName,
  tagline,
  address,
  openingHours,
  whatsappUrl,
  logoText,
  logo,
  navItems = [],
} = Astro.props;

const currentYear = new Date().getFullYear();
const initials = (logoText || businessName
  .split(' ')
  .filter(Boolean)
  .map((word) => word[0])
  .join(''))
  .slice(0, 3)
  .toUpperCase();
---

<footer class="border-t border-gray-800 bg-gray-950 text-white">
  <Container class="py-10 sm:py-12">
    <div class="grid gap-8 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-3">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-white p-1 text-[0.95rem] font-black text-gray-950">
            {logo?.src ? (
              <img src={logo.src} alt={logo.alt} class="h-full w-full object-contain" loading="lazy" decoding="async" />
            ) : (
              initials
            )}
          </span>
          <p class="text-xl font-bold">{businessName}</p>
        </div>
        <p class="mt-4 max-w-md text-base leading-8 text-gray-300">
          {tagline}
        </p>
        <a
          href={whatsappUrl}
          class="mt-5 inline-flex min-h-11 items-center justify-center rounded-lg bg-[var(--theme-primary,#ea580c)] px-5 py-3 text-base font-semibold text-white transition hover:opacity-90"
          aria-label={`Hubungi ${businessName} lewat WhatsApp`}
        >
          Hubungi WhatsApp
        </a>
      </div>

      <div>
        <p class="text-base font-semibold text-white">Kontak</p>
        <div class="mt-3 space-y-2 text-base leading-8 text-gray-300">
          <p>{address}</p>
          <p>{openingHours}</p>
        </div>
      </div>

      {
        navItems.length > 0 && (
          <div>
            <p class="text-base font-semibold text-white">Navigasi</p>
            <div class="mt-3 flex flex-col gap-2">
              {navItems.map((item) => (
                <a
                  href={item.href}
                  class="text-base text-gray-300 transition hover:text-white"
                >
                  {item.label}
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>

    <div class="mt-10 border-t border-gray-800 pt-6 text-[0.95rem] leading-7 text-gray-400 sm:flex sm:items-center sm:justify-between sm:gap-6">
      <p>&copy; {currentYear} {businessName}. Sample project untuk portfolio landing page UMKM.</p>
      <p class="mt-2 sm:mt-0">
        Demo concept — bukan bisnis asli.
      </p>
    </div>
  </Container>
</footer>
